# ==============================
# ContentOS runtime
# ==============================
CONTENTOS_ENVIRONMENT=development

# Local: leave empty and use SQLite.
# Production: managed PostgreSQL URL.
DATABASE_URL=
CONTENTOS_DATABASE_PATH=data/content.db

# Dashboard/API
CONTENTOS_CORS_ORIGINS=https://sreevishnubn.github.io,https://dashboard.youtube.analysis.com,http://localhost:5500,http://localhost:8000
CONTENTOS_API_TOKEN=

# LLM
CONTENTOS_LLM_PROVIDER=openrouter
CONTENTOS_LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# YouTube OAuth client configuration.
# The one-time OAuth flow uses a downloaded Google client JSON locally.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_PATH=data/youtube_token.json

# Research
CONTENTOS_RESEARCH_FEEDS=

# Text-to-speech
CONTENTOS_TTS_PROVIDER=openai
CONTENTOS_TTS_MODEL=gpt-4o-mini-tts
CONTENTOS_TTS_VOICE=alloy
