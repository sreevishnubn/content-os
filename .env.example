# ==============================
# ContentOS runtime
# ==============================
CONTENTOS_ENVIRONMENT=development

# Local development: leave DATABASE_URL empty and use SQLite.
# Production: set this to your hosted PostgreSQL connection string.
DATABASE_URL=
CONTENTOS_DATABASE_PATH=data/content.db

# Browser/API configuration
CONTENTOS_CORS_ORIGINS=https://sreevishnubn.github.io,https://dashboard.youtube.analysis.com,http://localhost:5500,http://localhost:8000
CONTENTOS_API_TOKEN=

# LLM provider configuration (never commit real secrets)
CONTENTOS_LLM_PROVIDER=
CONTENTOS_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Future external integrations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
